{
  "name": "collage-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based Instagram collage, photo and video carousel editor.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs",
    "artifact": "node scripts/build-artifact.mjs",
    "test:unit": "node scripts/run-unit.mjs",
    "test:e2e": "for f in tests/e2e/edit-*.js; do node \"$f\" || exit 1; done",
    "audit": "node tests/audit/run.js"
  },
  "dependencies": {
    "immer": "10.1.1",
    "konva": "9.3.16",
    "lucide-react": "0.451.0",
    "mp4-muxer": "5.1.3",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "18.2.10",
    "webm-muxer": "5.0.3",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
